# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# Splunk Observability Cloud
# Realm: us0, us1, eu0, ap0, etc.
SPLUNK_REALM=us1

# O11y ingest token (used by the collector's self-telemetry / default exporters)
SPLUNK_ACCESS_TOKEN=YOUR_INGEST_TOKEN

# RUM access token — create in Org Settings → Access Tokens (type: RUM)
SPLUNK_RUM_ACCESS_TOKEN=YOUR_RUM_ACCESS_TOKEN

# HEC token for local Splunk Enterprise.
# Use any UUID — the Splunk container will create this token automatically.
# Generate one with: python3 -c "import uuid; print(uuid.uuid4())"
SPLUNK_HEC_TOKEN=aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee

# Password for the local Splunk Enterprise admin UI (localhost:8000).
# Minimum 8 characters; must contain letters and numbers.
SPLUNK_LOCAL_PASSWORD=ChangeMeNow1
